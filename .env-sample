# Copy to .env and fill in real values before running aio app run / aio app deploy

# Adobe I/O Runtime namespace (set automatically by aio app use)
# AIO_RUNTIME_NAMESPACE=
# AIO_RUNTIME_AUTH=

# Adobe Analytics service API key (bound to apiKey input in ext.config.yaml)
SERVICE_API_KEY=

# OAuth Server-to-Server credentials for the analytics action.
# With `include-ims-credentials: true`, these are injected automatically at
# deploy time from the workspace's OAuth S2S credential — you normally do NOT
# need to set them here manually. Uncomment only for local testing.
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_ORG_ID=
# OAUTH_SCOPES=
